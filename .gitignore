# Allowlist: sales exports and forecasts are business data
/*
!/.gitignore
!/README.md
!/LICENSE
!/requirements.txt
!/sales_forecast.py
!/export_to_daily.py
!/export_to_detail.py
!/tests/

*.csv
*.png
__pycache__/

# Secrets: never commit env files (keep the example template)
.env
.env.*
*.env
*.env.txt
.env.txt
.dev.vars
!.env.example
*.pem
*.key
id_rsa*
id_ed25519*
credentials*.json
client_secret*.json
